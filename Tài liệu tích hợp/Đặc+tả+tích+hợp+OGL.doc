<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: bash; gutter: false; theme: Confluence" data-theme=3D"Confluence">curl --=
location --request POST &lt;BaseUrl&gt;/ap/create-invoice' \
--header 'Authorization: &lt;JWT_ACCESS_TOKEN&gt;' \
--header 'Content-Type: application/json' \
--data-raw '{
"requestId": "req1",
"referenceId": "dntt1",
"vendorNumber": "00055247",
"entity": "106",
"invoiceNumber": "TH.DUY_14072026_40_03_01",
"currency": "VND",
"amount": 5000,
"maker": "th.duy",
"checker": "th.duy",
"cashout": "Y",
"contractId": "HD123"
}'</pre>
</div>
</div>
