<h2 local-id=3D"31cb77b7766f" id=3D"FSDThanhto=C3=A1n-2.7.Quyt=E1=BA=AFcsin=
hb=C3=BAtto=C3=A1nt=E1=BB=B1=C4=91=E1=BB=99ng">2.7. Quy t=E1=BA=AFc sinh b=
=C3=BAt to=C3=A1n t=E1=BB=B1 =C4=91=E1=BB=99ng</h2>
<p local-id=3D"305afb500e00">Ph=E1=BA=A7n n=C3=A0y m=C3=B4 t=E1=BA=A3 quy t=
=E1=BA=AFc sinh b=C3=BAt to=C3=A1n k=E1=BA=BF to=C3=A1n, =C4=91=C6=B0=E1=BB=
=A3c =C3=A1p d=E1=BB=A5ng t=E1=BA=A1i tab Th=C3=B4ng tin h=E1=BA=A1ch to=C3=
=A1n khi NSD xem v=C3=A0 ho=C3=A0n thi=E1=BB=87n b=C3=BAt to=C3=A1n tr=C6=
=B0=E1=BB=9Bc khi tr=C3=ACnh duy=E1=BB=87t, v=C3=A0 =C4=91=C6=B0=E1=BB=A3c =
=C3=A1p d=E1=BB=A5ng l=E1=BA=A1i khi g=E1=BB=ADi ch=C3=ADnh th=E1=BB=A9c sa=
ng OGL sau khi phi=E1=BA=BFu Thanh to=C3=A1n =C4=91=C6=B0=E1=BB=A3c ph=C3=
=AA duy=E1=BB=87t.</p>
<h2 local-id=3D"fd99868c1cf7" id=3D"FSDThanhto=C3=A1n-2.7.1.Nguy=C3=AAnt=E1=
=BA=AFcchung"><strong>2.7.1. Nguy=C3=AAn t=E1=BA=AFc chung</strong></h2>
<p local-id=3D"0703087efc25">M=E1=BB=97i phi=E1=BA=BFu thanh to=C3=A1n b=E1=
=BA=AFt bu=E1=BB=99c g=E1=BA=AFn v=E1=BB=9Bi =C3=ADt nh=E1=BA=A5t m=E1=BB=
=99t trong ba ngu=E1=BB=93n: h=C3=B3a =C4=91=C6=A1n m=E1=BB=9Bi, ho=C3=A0n =
=E1=BB=A9ng, ho=E1=BA=B7c tr=E1=BA=A3 kho=E1=BA=A3n treo - thi=E1=BA=BFu c=
=E1=BA=A3 ba th=C3=AC h=E1=BB=87 th=E1=BB=91ng s=E1=BA=BD ch=E1=BA=B7n khi =
sinh h=E1=BA=A1ch to=C3=A1n. Khi ngu=E1=BB=93n l=C3=A0 tr=E1=BA=A3 kho=E1=
=BA=A3n treo, phi=E1=BA=BFu ch=E1=BB=89 tr=E1=BA=A3 ti=E1=BA=BFp ph=E1=BA=
=A7n =C4=91=C3=A3 treo t=E1=BB=AB phi=E1=BA=BFu tr=C6=B0=E1=BB=9Bc, kh=C3=
=B4ng ghi nh=E1=BA=ADn l=E1=BA=A1i chi ph=C3=AD.</p>
<p local-id=3D"cac2412f3f5f">Gi=C3=A1 tr=E1=BB=8B h=C3=B3a =C4=91=C6=A1n v=
=C3=A0 S=E1=BB=91 ti=E1=BB=81n =C4=91=E1=BB=81 ngh=E1=BB=8B thanh to=C3=A1n=
 l=C3=A0 hai gi=C3=A1 tr=E1=BB=8B =C4=91=E1=BB=99c l=E1=BA=ADp, kh=C3=B4ng =
nh=E1=BA=A5t thi=E1=BA=BFt b=E1=BA=B1ng nhau. Gi=C3=A1 tr=E1=BB=8B h=C3=B3a=
 =C4=91=C6=A1n quy=E1=BA=BFt =C4=91=E1=BB=8Bnh TT-BT-01/02/03 (chi ph=C3=AD=
, thu=E1=BA=BF, v=C3=A0 ngh=C4=A9a v=E1=BB=A5 ph=E1=BA=A3i tr=E1=BA=A3 =C4=
=91=E1=BA=A7y =C4=91=E1=BB=A7 theo h=C3=B3a =C4=91=C6=A1n); S=E1=BB=91 ti=
=E1=BB=81n =C4=91=E1=BB=81 ngh=E1=BB=8B thanh to=C3=A1n quy=E1=BA=BFt =C4=
=91=E1=BB=8Bnh S=E1=BB=91 ti=E1=BB=81n c=C3=B2n l=E1=BA=A1i d=E1=BB=B1 ki=
=E1=BA=BFn (ph=E1=BA=A7n =C4=91=C6=B0=E1=BB=A3c x=E1=BB=AD l=C3=BD b=E1=BA=
=B1ng ho=C3=A0n =E1=BB=A9ng v=C3=A0 th=E1=BB=B1c chi tr=E1=BA=A3 trong phi=
=E1=BA=BFu n=C3=A0y). Ch=C3=AAnh l=E1=BB=87ch gi=E1=BB=AFa hai gi=C3=A1 tr=
=E1=BB=8B n=C3=A0y (n=E1=BA=BFu c=C3=B3) v=E1=BA=ABn n=E1=BA=B1m nguy=C3=AA=
n tr=C3=AAn T=C3=A0i kho=E1=BA=A3n ph=E1=BA=A3i tr=E1=BA=A3 c=E1=BB=A7a NCC=
, ch=E1=BB=9D x=E1=BB=AD l=C3=BD =E1=BB=9F phi=E1=BA=BFu sau.</p>
<p local-id=3D"959f9efbbf68">N=C4=83m bi=E1=BA=BFn sau x=C3=A1c =C4=91=E1=
=BB=8Bnh theo t=E1=BB=ABng phi=E1=BA=BFu, quy=E1=BA=BFt =C4=91=E1=BB=8Bnh d=
=C3=B2ng b=C3=BAt to=C3=A1n n=C3=A0o =C4=91=C6=B0=E1=BB=A3c k=C3=ADch ho=E1=
=BA=A1t:</p>
