=B0=E1=BB=9Dng c=C3=B2n thi=E1=BA=BFu v=C3=A0 kh=C3=B4ng cho chuy=E1=BB=83n=
 tr=E1=BA=A1ng th=C3=A1i. CB =C4=90MMS ph=E1=BA=A3i ho=C3=A0n thi=E1=BB=87n=
 th=C3=B4ng tin tr=C6=B0=E1=BB=9Bc khi th=E1=BB=AD l=E1=BA=A1i.</p>
<p local-id=3D"33c8aef308c9"><strong>Tr=C3=ACnh phi=E1=BA=BFu khi c=C3=B3 h=
=C3=B3a =C4=91=C6=A1n =C4=91=C3=A3 h=E1=BA=BFt hi=E1=BB=87u l=E1=BB=B1c (BR=
-002-16):</strong> <span class=3D"inline-comment-marker" data-ref=3D"bb5a35=
a4-82a4-431f-995b-cd0e8ff08d9f">ngay khi nh=E1=BA=A5n Tr=C3=ACnh phi=E1=BA=
=BFu, h=E1=BB=87 th=E1=BB=91ng t=C3=A1i ki=E1=BB=83m tra tr=E1=BA=A1ng th=
=C3=A1i hi=E1=BB=87n t=E1=BA=A1i c=E1=BB=A7a to=C3=A0n b=E1=BB=99 h=C3=B3a =
=C4=91=C6=A1n =C4=91=C3=A3 g=E1=BA=AFn =E1=BB=9F m=E1=BB=8Di NCC trong phi=
=E1=BA=BFu - kh=C3=B4ng d=C3=B9ng l=E1=BA=A1i k=E1=BA=BFt qu=E1=BA=A3 ki=E1=
=BB=83m tra t=E1=BA=A1i th=E1=BB=9Di =C4=91i=E1=BB=83m ch=E1=BB=8Dn h=C3=B3=
a =C4=91=C6=A1n (ch=E1=BB=89 ki=E1=BB=83m tra l=E1=BA=A1i =C4=91=E1=BB=91i =
v=E1=BB=9Bi h=C3=B3a =C4=91=C6=A1n qu=C3=A1 T+2 so v=E1=BB=9Bi ng=C3=A0y ki=
=E1=BB=83m tra g=E1=BA=A7n nh=E1=BA=A5t</span>. N=E1=BA=BFu ph=C3=A1t hi=E1=
=BB=87n h=C3=B3a =C4=91=C6=A1n n=C3=A0o kh=C3=B4ng c=C3=B2n =E1=BB=9F tr=E1=
=BA=A1ng th=C3=A1i H=E1=BB=A3p l=E1=BB=87 (=C4=91=C3=A3 chuy=E1=BB=83n sang=
 H=E1=BA=BFt h=E1=BA=A1n ki=E1=BB=83m tra, =C4=90ang ki=E1=BB=83m tra ho=E1=
=BA=B7c Kh=C3=B4ng h=E1=BB=A3p l=E1=BB=87), h=E1=BB=87 th=E1=BB=91ng ch=E1=
=BA=B7n Tr=C3=ACnh phi=E1=BA=BFu v=C3=A0 hi=E1=BB=83n th=E1=BB=8B l=E1=BB=
=97i n=C3=AAu r=C3=B5 S=E1=BB=91 h=C3=B3a =C4=91=C6=A1n c=C3=B9ng NCC t=C6=
=B0=C6=A1ng =E1=BB=A9ng, y=C3=AAu c=E1=BA=A7u CB =C4=90MMS g=E1=BB=A1 ho=E1=
=BA=B7c thay h=C3=B3a =C4=91=C6=A1n =C4=91=C3=B3 tr=C6=B0=E1=BB=9Bc khi tr=
=C3=ACnh l=E1=BA=A1i.</p>
