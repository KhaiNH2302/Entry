n></h2>
<p local-id=3D"e013b3e6e5cf">Ph=E1=BA=A7n n=C3=A0y m=C3=B4 t=E1=BA=A3 quy t=
=E1=BA=AFc sinh b=C3=BAt to=C3=A1n k=E1=BA=BF to=C3=A1n, =C4=91=C6=B0=E1=BB=
=A3c =C3=A1p d=E1=BB=A5ng t=E1=BA=A1i <span class=3D"inline-comment-marker"=
 data-ref=3D"25236b93-f8c3-4cff-b213-510380e6d2af">tab Th=C3=B4ng tin h=E1=
=BA=A1ch to=C3=A1n</span> (M=E1=BB=A5c 3.4 =E2=80=93 FS-TU-003) khi NSD xem=
 v=C3=A0 ho=C3=A0n thi=E1=BB=87n b=C3=BAt to=C3=A1n tr=C6=B0=E1=BB=9Bc khi =
tr=C3=ACnh duy=E1=BB=87t, v=C3=A0 =C4=91=C6=B0=E1=BB=A3c =C3=A1p d=E1=BB=A5=
ng l=E1=BA=A1i khi g=E1=BB=ADi ch=C3=ADnh th=E1=BB=A9c sang OGL sau khi phi=
=E1=BA=BFu T=E1=BA=A1m =E1=BB=A9ng =C4=91=C6=B0=E1=BB=A3c ph=C3=AA duy=E1=
=BB=87t (M=E1=BB=A5c 3.6 =E2=80=93 FS-TU-005).</p>
<h3 local-id=3D"df363bb744f1" id=3D"FSDT=E1=BA=A1m=E1=BB=A9ng-2.7.1.Nguy=C3=
=AAnt=E1=BA=AFcchung">2.7.1. Nguy=C3=AAn t=E1=BA=AFc chung</h3>
<p local-id=3D"da18e106b1dc">M=E1=BB=97i phi=E1=BA=BFu t=E1=BA=A1m =E1=BB=
=A9ng, theo t=E1=BB=ABng nh=C3=A0 cung c=E1=BA=A5p (NCC), lu=C3=B4n ph=C3=
=A1t sinh <span class=3D"inline-comment-marker" data-ref=3D"37ee2efe-2b86-4=
95c-9826-a240e32930df">t=E1=BB=91i thi=E1=BB=83u hai kh=E1=BB=91i b=C3=BAt =
to=C3=A1n: ghi nh=E1=BA=ADn kho=E1=BA=A3n t=E1=BA=A1m =E1=BB=A9ng v=C3=A0 t=
r=E1=BA=A3 ti=E1=BB=81n cho NCC</span>. Kh=E1=BB=91i ghi nh=E1=BA=ADn thu=
=E1=BA=BF GTGT ch=E1=BB=89 ph=C3=A1t sinh khi h=C3=B3a =C4=91=C6=A1n c=E1=
=BB=A7a NCC c=C3=B3 thu=E1=BA=BF</p>
<p local-id=3D"920d77355a35">Hai =C4=91i=E1=BB=81u ki=E1=BB=87n sau x=C3=A1=
